# Copia este archivo como .env y pone tus valores. El .env NO va al repositorio.

# La conexion del API. Entra como lis_api (sin privilegios) y cada peticion se
# pone el rol lis_app dentro de su transaccion (prisma.service.ts).
DATABASE_URL=postgresql://lis_api:LA_CLAVE@localhost:5432/prolissaas

# Conexiones del pool de pg (por defecto 10). Cada peticion retiene una durante
# su transaccion. Si el log muestra "P2028 -> 503" seguido, subirlo; nunca mas
# que max_connections de Postgres menos lo que usen las otras apps.
DB_POOL_MAX=10

# Con que firma los tokens. Largo y al azar; cambiarlo cierra todas las sesiones.
JWT_SECRETO=CAMBIAME_POR_ALGO_LARGO_Y_AL_AZAR
# Cuanto dura una sesion ("8h", "30m").
JWT_VENCE_EN=8h

# De donde acepta peticiones el CORS (el front).
ORIGEN_FRONT=http://localhost:4200
PORT=3000
