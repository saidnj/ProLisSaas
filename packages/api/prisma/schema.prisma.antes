  apellidos                                                     String
  nombre_completo                                               String?               @default(dbgenerated("((apellidos || ', '::text) || nombres)"))
  tipo_documento                                                tipo_documento        @default(ninguno)
  documento                                                     String?
  fecha_nacimiento                                              DateTime?             @db.Date
  sexo                                                          sexo                  @default(no_especificado)
  telefono                                                      String?
  correo                                                        String?
  direccion                                                     String?
  fusionado_en_paciente_id                                      BigInt?
  fusionado_en                                                  DateTime?             @db.Timestamptz(6)
  fusionado_por_usuario_id                                      BigInt?
  creado_por_usuario_id                                         BigInt?
  creado_en                                                     DateTime              @default(now()) @db.Timestamptz(6)
  episodio                                                      episodio[]
  usuario_paciente_creado_por_usuario_id_empresa_idTousuario    usuario?              @relation("paciente_creado_por_usuario_id_empresa_idTousuario", fields: [creado_por_usuario_id, empresa_id], references: [usuario_id, empresa_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_paciente_creado_por")
  usuario_paciente_fusionado_por_usuario_id_empresa_idTousuario usuario?              @relation("paciente_fusionado_por_usuario_id_empresa_idTousuario", fields: [fusionado_por_usuario_id, empresa_id], references: [usuario_id, empresa_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_paciente_fusionado_por")
  empresa                                                       empresa               @relation(fields: [empresa_id], references: [empresa_id], onDelete: NoAction, onUpdate: NoAction)
  paciente                                                      paciente?             @relation("pacienteTopaciente", fields: [fusionado_en_paciente_id], references: [paciente_id], onDelete: NoAction, onUpdate: NoAction)
  other_paciente                                                paciente[]            @relation("pacienteTopaciente")
  paciente_referencia                                           paciente_referencia[]

  @@unique([empresa_id, tipo_documento, documento], map: "uq_paciente_documento", where: raw("((documento IS NOT NULL) AND (fusionado_en_paciente_id IS NULL))"))
  @@unique([paciente_id, empresa_id], map: "uq_paciente_empresa")
  @@unique([empresa_id, expediente], map: "uq_paciente_expediente")
  @@index([empresa_id, nombre_completo], map: "ix_paciente_nombre", where: raw("(fusionado_en_paciente_id IS NULL)"))
  @@schema("core")
}

