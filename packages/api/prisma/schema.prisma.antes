generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["audit", "comercial", "core", "integra", "lab", "plataforma"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model evento {
  evento_id      BigInt   @id @default(autoincrement())
  empresa_id     BigInt?
  usuario_id     BigInt?
  ocurrido_en    DateTime @default(now()) @db.Timestamptz(6)
  accion         String
  nombre_esquema String
  nombre_tabla   String
  registro_id    BigInt?
  datos_antes    Json?
  datos_despues  Json?
  ip             String?  @db.Inet
  user_agent     String?
  empresa        empresa? @relation(fields: [empresa_id], references: [empresa_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([empresa_id, ocurrido_en(sort: Desc)], map: "ix_evento_empresa")
  @@index([nombre_esquema, nombre_tabla, registro_id], map: "ix_evento_registro")
  @@index([usuario_id, ocurrido_en(sort: Desc)], map: "ix_evento_usuario")
  @@schema("audit")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model cliente {
  cliente_id       BigInt            @id @default(autoincrement())
  nombre           String
  tipo             tipo_cliente
  rtn              String?           @unique(map: "uq_cliente_rtn", where: raw("(rtn IS NOT NULL)"))
  direccion_fiscal String?
  nota             String?
  creado_en        DateTime          @default(now()) @db.Timestamptz(6)
  cliente_empresa  cliente_empresa[]
  contacto         contacto[]
  contrato         contrato[]

  @@schema("comercial")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This table contains exclusion constraints and requires additional setup for migrations. Visit https://pris.ly/d/exclusion-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model cliente_empresa {
  cliente_id BigInt
  empresa_id BigInt
  desde      DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  hasta      DateTime? @db.Date
  nota       String?
  cliente    cliente   @relation(fields: [cliente_id], references: [cliente_id], onDelete: NoAction, onUpdate: NoAction)
  empresa    empresa   @relation(fields: [empresa_id], references: [empresa_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([cliente_id, empresa_id, desde])
  @@schema("comercial")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model contacto {
  contacto_id BigInt         @id @default(autoincrement())
  cliente_id  BigInt
  nombre      String
  papel       papel_contacto @default(general)
  cargo       String?
  telefono    String?
  correo      String?
  activo      Boolean        @default(true)
  nota        String?
  creado_en   DateTime       @default(now()) @db.Timestamptz(6)
  cliente     cliente        @relation(fields: [cliente_id], references: [cliente_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cliente_id, papel], map: "ix_contacto_cliente", where: raw("activo"))
  @@schema("comercial")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model contrato {
  contrato_id           BigInt    @id @default(autoincrement())
  cliente_id            BigInt
  referencia            String?
  fecha_inicio          DateTime  @db.Date
  fecha_fin             DateTime? @db.Date
  renovacion_automatica Boolean   @default(false)
  moneda                String    @default("HNL")
  monto_periodo         Decimal?  @db.Decimal(12, 2)
  periodo_meses         Int       @default(1) @db.SmallInt
  condiciones           String?
  cliente               cliente   @relation(fields: [cliente_id], references: [cliente_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cliente_id, fecha_inicio(sort: Desc)], map: "ix_contrato_cliente")
  @@schema("comercial")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model motivo {
  motivo_id         String            @id
  tipo_evento       tipo_evento
  nombre            String
  descripcion       String?
  nivel_inmediato   nivel_acceso      @default(solo_lectura)
  dias_plazo        Int?
  nivel_al_vencer   nivel_acceso?
  estado_al_vencer  estado_empresa?
  aviso_previo_dias Int               @default(0) @db.SmallInt
  permite_exportar  Boolean           @default(true)
  reversible        Boolean           @default(true)
  requiere_nota     Boolean           @default(false)
  politica_definida Boolean           @default(false)
  activo            Boolean           @default(true)
  creado_en         DateTime          @default(now()) @db.Timestamptz(6)
  relacion_evento   relacion_evento[]

  @@schema("comercial")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model relacion_evento {
  evento_id                 BigInt          @id @default(autoincrement())
  empresa_id                BigInt
  tipo_evento               tipo_evento
  motivo_id                 String
  fecha                     DateTime        @default(dbgenerated("CURRENT_DATE")) @db.Date
  nivel_aplicado            nivel_acceso
  dias_plazo_aplicado       Int?
  nivel_al_vencer_aplicado  nivel_acceso?
  estado_al_vencer_aplicado estado_empresa?
  fecha_vencimiento         DateTime?       @db.Date
  politica_estaba_definida  Boolean
  nota                      String?
  registrado_por            String
  registrado_en             DateTime        @default(now()) @db.Timestamptz(6)
  empresa                   empresa         @relation(fields: [empresa_id], references: [empresa_id], onDelete: NoAction, onUpdate: NoAction)
  motivo                    motivo          @relation(fields: [motivo_id], references: [motivo_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([empresa_id, fecha(sort: Desc), evento_id(sort: Desc)], map: "ix_relacion_evento_empresa")
  @@schema("comercial")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model acceso_sucursal {
  usuario_id  BigInt
  sucursal_id BigInt
  empresa_id  BigInt
  creado_en   DateTime @default(now()) @db.Timestamptz(6)
  empresa     empresa  @relation(fields: [empresa_id], references: [empresa_id], onDelete: NoAction, onUpdate: NoAction)
  sucursal    sucursal @relation(fields: [sucursal_id, empresa_id], references: [sucursal_id, empresa_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_acceso_sucursal")
  usuario     usuario  @relation(fields: [usuario_id, empresa_id], references: [usuario_id, empresa_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_acceso_usuario")

  @@id([usuario_id, sucursal_id])
  @@schema("core")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model convenio {
  convenio_id                                  BigInt          @id @default(autoincrement())
  empresa_id                                   BigInt          @unique(map: "uq_convenio_predeterminado", where: raw("es_predeterminado"))
  nombre                                       String
  tipo                                         tipo_convenio
  modalidad_cobro                              modalidad_cobro @default(particular)
  copago_porcentaje                            Decimal?        @db.Decimal(5, 2)
  dia_corte                                    Int?            @db.SmallInt
  recibe_copia_informe                         Boolean         @default(false)
  es_predeterminado                            Boolean         @default(false)
  empresa_destino_id                           BigInt?
  rtn                                          String?
  contacto                                     String?
  telefono                                     String?
  activo                                       Boolean         @default(true)
  creado_en                                    DateTime        @default(now()) @db.Timestamptz(6)
  empresa_convenio_empresa_destino_idToempresa empresa?        @relation("convenio_empresa_destino_idToempresa", fields: [empresa_destino_id], references: [empresa_id], onDelete: NoAction, onUpdate: NoAction)
  empresa_convenio_empresa_idToempresa         empresa         @relation("convenio_empresa_idToempresa", fields: [empresa_id], references: [empresa_id], onDelete: NoAction, onUpdate: NoAction)
  episodio                                     episodio[]
  orden_prueba                                 orden_prueba[]
  precio_prueba                                precio_prueba[]

  @@unique([convenio_id, empresa_id], map: "uq_convenio_empresa")
  @@unique([empresa_id, nombre], map: "uq_convenio_nombre")
  @@schema("core")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model correlativo {
  correlativo_id BigInt           @id @default(autoincrement())
  empresa_id     BigInt
  sucursal_id    BigInt?
  tipo           tipo_correlativo
  prefijo        String           @default("")
  ancho          Int              @default(6) @db.SmallInt
  ultimo_valor   BigInt           @default(0)
  empresa        empresa          @relation(fields: [empresa_id], references: [empresa_id], onDelete: NoAction, onUpdate: NoAction)
  sucursal       sucursal?        @relation(fields: [sucursal_id, empresa_id], references: [sucursal_id, empresa_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_correlativo_sucursal")

  @@schema("core")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model empleado {
  empleado_id        BigInt   @id @default(autoincrement())
  empresa_id         BigInt
  nombres            String
  apellidos          String
  documento          String?
  telefono           String?
  correo             String?
  cargo              String?
  numero_colegiacion String?
  activo             Boolean  @default(true)
  creado_en          DateTime @default(now()) @db.Timestamptz(6)
  empresa            empresa  @relation(fields: [empresa_id], references: [empresa_id], onDelete: NoAction, onUpdate: NoAction)
  usuario            usuario?

  @@unique([empleado_id, empresa_id], map: "uq_empleado_empresa")
  @@schema("core")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model empresa {
  empresa_id                                                              BigInt                @id @default(autoincrement())
  nombre                                                                  String
  nombre_comercial                                                        String?
  rtn                                                                     String?               @unique(map: "uq_empresa_rtn", where: raw("(rtn IS NOT NULL)"))
  estado                                                                  estado_empresa        @default(prueba)
  nivel_acceso                                                            nivel_acceso          @default(completo)
  fecha_cierre                                                            DateTime?             @db.Date
  creado_en                                                               DateTime              @default(now()) @db.Timestamptz(6)
  evento                                                                  evento[]
  cliente_empresa                                                         cliente_empresa[]
  relacion_evento                                                         relacion_evento[]
  acceso_sucursal                                                         acceso_sucursal[]
  convenio_convenio_empresa_destino_idToempresa                           convenio[]            @relation("convenio_empresa_destino_idToempresa")
  convenio_convenio_empresa_idToempresa                                   convenio?             @relation("convenio_empresa_idToempresa")
  correlativo                                                             correlativo[]
  empleado                                                                empleado[]
  entrega                                                                 entrega[]
  episodio                                                                episodio[]
  informe                                                                 informe[]
  informe_version                                                         informe_version[]
  mensaje                                                                 mensaje[]
  paciente                                                                paciente[]
  paciente_referencia_paciente_referencia_contraparte_empresa_idToempresa paciente_referencia[] @relation("paciente_referencia_contraparte_empresa_idToempresa")
  paciente_referencia_paciente_referencia_empresa_idToempresa             paciente_referencia[] @relation("paciente_referencia_empresa_idToempresa")
  rol                                                                     rol[]
  rol_permiso                                                             rol_permiso[]
  sucursal                                                                sucursal[]
  usuario                                                                 usuario[]
  equipo                                                                  equipo[]
  intento_proceso                                                         intento_proceso[]
  mapeo_codigo                                                            mapeo_codigo[]
  mensaje_crudo                                                           mensaje_crudo[]
  analito                                                                 analito[]
  area                                                                    area[]
  aviso_valor_critico                                                     aviso_valor_critico[]
  muestra                                                                 muestra[]
  muestra_rechazo                                                         muestra_rechazo[]
  orden                                                                   orden[]
  orden_prueba                                                            orden_prueba[]
  precio_prueba                                                           precio_prueba[]
  prueba                                                                  prueba[]
  prueba_analito                                                          prueba_analito[]
  rango_referencia                                                        rango_referencia[]
  resultado                                                               resultado[]
  tipo_muestra                                                            tipo_muestra[]
  modulo_sucursal                                                         modulo_sucursal[]

  @@index([estado, fecha_cierre], map: "ix_empresa_cierre", where: raw("(fecha_cierre IS NOT NULL)"))
  @@schema("core")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model entrega {
  entrega_id               BigInt          @id @default(autoincrement())
  empresa_id               BigInt
  informe_version_id       BigInt
  medio                    medio_entrega
  entregado_a              String
  parentesco               String?
  documento_receptor       String?
  entregado_por_usuario_id BigInt
  entregado_en             DateTime        @default(now()) @db.Timestamptz(6)
  empresa                  empresa         @relation(fields: [empresa_id], references: [empresa_id], onDelete: NoAction, onUpdate: NoAction)
  informe_version          informe_version @relation(fields: [informe_version_id], references: [informe_version_id], onDelete: NoAction, onUpdate: NoAction)
  usuario                  usuario         @relation(fields: [entregado_por_usuario_id, empresa_id], references: [usuario_id, empresa_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_entrega_usuario")

  @@schema("core")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model episodio {
  episodio_id           BigInt          @id @default(autoincrement())
  empresa_id            BigInt
  sucursal_id           BigInt
  paciente_id           BigInt
  convenio_id           BigInt
  mensaje_id            BigInt?
  numero                String
  estado                estado_episodio @default(abierto)
  urgente               Boolean         @default(false)
  observacion           String?
  anulado_motivo        String?
  creado_por_usuario_id BigInt
  creado_en             DateTime        @default(now()) @db.Timestamptz(6)
  cerrado_en            DateTime?       @db.Timestamptz(6)
  empresa               empresa         @relation(fields: [empresa_id], references: [empresa_id], onDelete: NoAction, onUpdate: NoAction)
  convenio              convenio        @relation(fields: [convenio_id, empresa_id], references: [convenio_id, empresa_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_episodio_convenio")
  mensaje               mensaje?        @relation(fields: [mensaje_id, empresa_id], references: [mensaje_id, empresa_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_episodio_mensaje")
  paciente              paciente        @relation(fields: [paciente_id, empresa_id], references: [paciente_id, empresa_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_episodio_paciente")
  sucursal              sucursal        @relation(fields: [sucursal_id, empresa_id], references: [sucursal_id, empresa_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_episodio_sucursal")
  usuario               usuario         @relation(fields: [creado_por_usuario_id, empresa_id], references: [usuario_id, empresa_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_episodio_usuario")
  informe               informe[]
  orden                 orden?

  @@unique([episodio_id, empresa_id], map: "uq_episodio_empresa")
  @@unique([empresa_id, numero], map: "uq_episodio_numero")
  @@index([empresa_id, paciente_id, creado_en(sort: Desc)], map: "ix_episodio_paciente")
  @@index([empresa_id, sucursal_id, creado_en(sort: Desc)], map: "ix_episodio_pendientes", where: raw("(estado = 'abierto'::core.estado_episodio)"))
  @@schema("core")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model informe {
  informe_id      BigInt            @id @default(autoincrement())
  empresa_id      BigInt
  episodio_id     BigInt
  modulo_id       String
  numero          String
  estado          estado_informe    @default(borrador)
  episodio        episodio          @relation(fields: [episodio_id, empresa_id], references: [episodio_id, empresa_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_informe_episodio")
  empresa         empresa           @relation(fields: [empresa_id], references: [empresa_id], onDelete: NoAction, onUpdate: NoAction)
  modulo          modulo            @relation(fields: [modulo_id], references: [modulo_id], onDelete: NoAction, onUpdate: NoAction)
  informe_version informe_version[]
  orden           orden[]

  @@unique([informe_id, empresa_id], map: "uq_informe_empresa")
  @@unique([empresa_id, numero], map: "uq_informe_numero")
  @@schema("core")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model informe_version {
  informe_version_id     BigInt    @id @default(autoincrement())
  empresa_id             BigInt
  informe_id             BigInt
  version                Int
  motivo_correccion      String?
  archivo_ruta           String?
  archivo_hash           String?
  emitido_por_usuario_id BigInt
  emitido_en             DateTime  @default(now()) @db.Timestamptz(6)
  entrega                entrega[]
  informe                informe   @relation(fields: [informe_id, empresa_id], references: [informe_id, empresa_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_informe_version_informe")
  usuario                usuario   @relation(fields: [emitido_por_usuario_id, empresa_id], references: [usuario_id, empresa_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_informe_version_usuario")
  empresa                empresa   @relation(fields: [empresa_id], references: [empresa_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([informe_id, version], map: "uq_informe_version")
  @@schema("core")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model mensaje {
  mensaje_id       BigInt              @id @default(autoincrement())
  empresa_id       BigInt
  enlace_id        BigInt
  sucursal_id      BigInt
  direccion        direccion_mensaje
  tipo             tipo_mensaje
  folio            String              @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  responde_a_folio String?             @db.Uuid
  contenido        Json
  estado           core_estado_mensaje @default(pendiente)
  creado_en        DateTime            @default(now()) @db.Timestamptz(6)
  entregado_en     DateTime?           @db.Timestamptz(6)
  trabajado_en     DateTime?           @db.Timestamptz(6)
  episodio         episodio[]
  sucursal         sucursal            @relation(fields: [sucursal_id, empresa_id], references: [sucursal_id, empresa_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mensaje_sucursal")
  empresa          empresa             @relation(fields: [empresa_id], references: [empresa_id], onDelete: NoAction, onUpdate: NoAction)
  enlace           enlace              @relation(fields: [enlace_id], references: [enlace_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([mensaje_id, empresa_id], map: "uq_mensaje_empresa")
  @@unique([empresa_id, folio], map: "uq_mensaje_folio")
  @@index([empresa_id, sucursal_id, estado], map: "ix_mensaje_bandeja", where: raw("(direccion = 'recibido'::core.direccion_mensaje)"))
  @@index([empresa_id, responde_a_folio], map: "ix_mensaje_hilo", where: raw("(responde_a_folio IS NOT NULL)"))
  @@index([empresa_id, creado_en], map: "ix_mensaje_sin_entregar", where: raw("((direccion = 'enviado'::core.direccion_mensaje) AND (estado = 'pendiente'::core.estado_mensaje))"))
  @@schema("core")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model paciente {
  paciente_id                                                   BigInt                @id @default(autoincrement())
